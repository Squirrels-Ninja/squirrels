{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Minimal",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "squirrels-primary",  "color": "#111111", "name": "Primary (Black)"    },
				{ "slug": "squirrels-accent",   "color": "#555555", "name": "Accent (Gray)"      },
				{ "slug": "squirrels-text",     "color": "#111111", "name": "Text"               },
				{ "slug": "squirrels-muted",    "color": "#888888", "name": "Muted"              },
				{ "slug": "squirrels-bg",       "color": "#FFFFFF", "name": "Background"         },
				{ "slug": "squirrels-surface",  "color": "#F9F9F9", "name": "Surface"            },
				{ "slug": "squirrels-border",   "color": "#EBEBEB", "name": "Border"             },
				{ "slug": "squirrels-white",    "color": "#FFFFFF", "name": "White"              },
				{ "slug": "squirrels-black",    "color": "#111111", "name": "Black"              }
			]
		}
	},
	"styles": {
		"color": { "background": "#FFFFFF", "text": "#111111" },
		"typography": {
			"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
			"fontSize": "1rem",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": { "color": { "text": "#111111" }, "typography": { "textDecoration": "underline" } },
			"h1": { "typography": { "fontWeight": "900", "letterSpacing": "-0.04em" } },
			"h2": { "typography": { "fontWeight": "800", "letterSpacing": "-0.03em" } },
			"button": {
				"color": { "background": "#111111", "text": "#FFFFFF" },
				"border": { "radius": "4px" },
				":hover": { "color": { "background": "#333333" } }
			}
		}
	}
}
